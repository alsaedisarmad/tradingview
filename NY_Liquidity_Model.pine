//@version=5
// ════════════════════════════════════════════════════════════════════════════
//  NY LIQUIDITY MODEL  —  محدّد مناطق (بلا توصية) / ZONE MAPPER (no trade calls)
//  للعقود الآجلة NQ / MNQ / ES في جلسة نيويورك فقط
//  Futures (NQ / MNQ / ES) — New York session only
// ────────────────────────────────────────────────────────────────────────────
//  الغرض: تحديد ورسم مناطق النموذج بدقة فقط — لا دخول/ستوب/هدف/توصية.
//  Purpose: precisely mark & draw the model zones only — no entry/stop/target.
//  يعمل على فريم 5 دقائق أو دقيقة (يتكيّف مع فريم الشارت) / runs on 5m or 1m.
// ────────────────────────────────────────────────────────────────────────────
//  المكوّنات بالترتيب الزمني الإلزامي:
//    ① Liquidity Levels → ② Sweep → ③ SMT → ④ Control Shift (MSS/CISD) → ⑤ FVG zone
// ════════════════════════════════════════════════════════════════════════════
indicator("NY Liquidity Model", overlay = true, max_boxes_count = 50, max_lines_count = 100, max_labels_count = 50)

// ════════════════════════════════════════════════════════════════════════════
//  الإعدادات القابلة للتعديل / INPUTS
// ════════════════════════════════════════════════════════════════════════════
tz = "America/New_York"   // كل التوقيتات بتوقيت نيويورك / all times in NY time

grpSess     = "① نوافذ الجلسات / Session Windows"
nySession   = input.session("0930-1130", "نافذة تداول نيويورك / NY Trade Window", group = grpSess, tooltip = "كل الإشارات تُرصد وتُرسم داخل هذه النافذة فقط")
asiaSession = input.session("1800-0300", "جلسة آسيا / Asia Session",              group = grpSess)
londonSess  = input.session("0300-0800", "جلسة لندن / London Session",            group = grpSess)

grpLvl      = "② مستويات السيولة / Liquidity Levels"
useAsia     = input.bool(true, "قمة/قاع آسيا / Asia H-L",             group = grpLvl)
useLondon   = input.bool(true, "قمة/قاع لندن / London H-L",          group = grpLvl)
usePrevDay  = input.bool(true, "قمة/قاع اليوم السابق / Prev Day H-L", group = grpLvl)

grpLogic    = "③ منطق النموذج / Model Logic"
pivotLen    = input.int(3, "طول Swing pivot / Swing Pivot Length", minval = 1, group = grpLogic)
maxWait     = input.int(15, "أقصى شموع لتحوّل السيطرة / Max Bars for Control Shift", minval = 1, group = grpLogic)
modeOpt     = input.string("MSS فقط / MSS only", "وضع تحوّل السيطرة / Control-Shift Mode", options = ["MSS فقط / MSS only", "CISD فقط / CISD only", "الاثنان / Both"], group = grpLogic, tooltip = "MSS = بنية (5m) | CISD = شمعة (1m) | الاثنان = CISD للتوقيت بعد تأكيد MSS")
minTicks    = input.int(4, "أدنى حجم FVG (تك) / Min FVG Size (ticks)", minval = 0, group = grpLogic)

grpSMT      = "④ SMT / التباين"
smtEnabled  = input.bool(true, "تفعيل SMT / Enable SMT", group = grpSMT)
smtSym      = input.symbol("ES1!", "رمز الأصل المقارن / SMT Symbol", group = grpSMT, tooltip = "عند تداول NQ1! ضع ES1! والعكس")
smtWin      = input.int(3, "نافذة SMT ± شموع / SMT Window ±", minval = 1, group = grpSMT)

grpStyle    = "⑤ الألوان / Colors"
colLiq      = input.color(color.new(color.gray, 60), "مستويات السيولة / Liquidity Levels", group = grpStyle)
colSweep    = input.color(#FF8C00,                    "Sweep",                              group = grpStyle)
colSMT      = input.color(#FFD700,                    "SMT",                                group = grpStyle)
colMSS      = input.color(#FFFFFF,                    "MSS",                                group = grpStyle)
colCISD     = input.color(#9370DB,                    "CISD",                               group = grpStyle)
colFVG      = input.color(color.new(#2196F3, 80),     "FVG",                                group = grpStyle)

grpGen      = "⑥ عام / General"
autoClean   = input.bool(false, "حذف الإشارات تلقائياً عند الإلغاء / Auto-delete signals on cancel", group = grpGen, tooltip = "معطّل افتراضياً: كل الإشارات (Sweep, SMT, MSS, CISD, FVG) تبقى ظاهرة على الشارت للمراجعة ولا تُحذف عند إلغاء الإعداد")

// وضع تحوّل السيطرة / control-shift mode flags
isMSSonly  = modeOpt == "MSS فقط / MSS only"
isCISDonly = modeOpt == "CISD فقط / CISD only"
isBoth     = modeOpt == "الاثنان / Both"

tick = syminfo.mintick

// ════════════════════════════════════════════════════════════════════════════
//  الأنواع / USER-DEFINED TYPES
// ════════════════════════════════════════════════════════════════════════════
// مستوى سيولة (قمة/قاع) يُرسم خطاً متقطعاً حتى يُخترق
type Liq
    float  price
    bool   isHigh          // true = قمة/مقاومة ، false = قاع/دعم
    line   ln
    bool   broken = false
    bool   swept  = false  // مُنِع تكرار استخدامه بعد سحبه
    string tag    = ""

var array<Liq> liqLevels = array.new<Liq>()

// ════════════════════════════════════════════════════════════════════════════
//  كشف الجلسات / SESSION DETECTION
// ════════════════════════════════════════════════════════════════════════════
inNY     = not na(time(timeframe.period, nySession,   tz))
inAsia   = not na(time(timeframe.period, asiaSession, tz))
inLondon = not na(time(timeframe.period, londonSess,  tz))
newDay   = time("D") != time("D")[1]

// ════════════════════════════════════════════════════════════════════════════
//  ① تتبّع قمم/قيعان الجلسات / SESSION HIGH-LOW TRACKING
// ════════════════════════════════════════════════════════════════════════════
var float asiaH = na
var float asiaL = na
if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low),  low)

var float londonH = na
var float londonL = na
if inLondon and not inLondon[1]
    londonH := high
    londonL := low
else if inLondon
    londonH := math.max(nz(londonH, high), high)
    londonL := math.min(nz(londonL, low),  low)

// قمة/قاع اليوم السابق — بدون repaint (lookahead_off)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_off)

// إضافة/تحديث مستوى (يحذف القديم بنفس المعرّف للحفاظ على النظافة)
f_addLevel(float px, bool isHigh, string tag) =>
    if array.size(liqLevels) > 0
        for i = array.size(liqLevels) - 1 to 0
            Liq old = array.get(liqLevels, i)
            if old.tag == tag
                line.delete(old.ln)
                array.remove(liqLevels, i)
    ln = line.new(bar_index, px, bar_index + 1, px, xloc = xloc.bar_index, color = colLiq, style = line.style_dashed, width = 1)
    array.push(liqLevels, Liq.new(price = px, isHigh = isHigh, ln = ln, tag = tag))

// ════════════════════════════════════════════════════════════════════════════
//  ③ SMT — بيانات الأصل المقارن (lookahead_off) / SMT comparison series
// ════════════════════════════════════════════════════════════════════════════
[compHigh, compLow] = request.security(smtSym, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)

// قمة/قاع جديد محلي على أصلنا مقابل الأصل المقارن خلال نافذة ±smtWin
win           = smtWin * 2 + 1
ourFreshLow   = low      <= ta.lowest(low,      win)
ourFreshHigh  = high     >= ta.highest(high,    win)
compFreshLow  = compLow  <= ta.lowest(compLow,  win)
compFreshHigh = compHigh >= ta.highest(compHigh, win)
// SMT صاعد: أصلنا صنع قاعاً جديداً (سحب) والمقارن لم يفعل — والعكس للهابط
smtBullEval   = smtEnabled and ourFreshLow  and not compFreshLow
smtBearEval   = smtEnabled and ourFreshHigh and not compFreshHigh

// ════════════════════════════════════════════════════════════════════════════
//  ④a MSS — تحوّل السيطرة البنيوي (5m) / structural swing shift
// ════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// ════════════════════════════════════════════════════════════════════════════
//  ④b CISD — تحوّل السيطرة الشمعي (1m) / candle-based shift on 1m
// ────────────────────────────────────────────────────────────────────────────
//  Bullish CISD: ≥2 شمعات حمراء متتالية → إغلاق شمعة خضراء فوق افتتاح أول حمراء
//  Bearish CISD: ≥2 شمعات خضراء متتالية → إغلاق شمعة حمراء تحت افتتاح أول خضراء
//  نُعيد عدّادات تصاعدية + المستوى، لالتقاط أي تأكيد داخل شمعة 5m عبر security
// ════════════════════════════════════════════════════════════════════════════
f_cisd() =>
    var int   redRun   = 0
    var float redOpen0 = na
    var int   grnRun   = 0
    var float grnOpen0 = na
    var int   bullN    = 0
    var float bullLvl  = na
    var int   bearN    = 0
    var float bearLvl  = na
    isRed = close < open
    isGrn = close > open
    if isGrn
        if redRun >= 2 and close > redOpen0            // تأكيد صاعد
            bullN   += 1
            bullLvl := redOpen0
        grnOpen0 := grnRun == 0 ? open : grnOpen0
        grnRun += 1
        redRun := 0
    else if isRed
        if grnRun >= 2 and close < grnOpen0            // تأكيد هابط
            bearN   += 1
            bearLvl := grnOpen0
        redOpen0 := redRun == 0 ? open : redOpen0
        redRun += 1
        grnRun := 0
    [bullN, bullLvl, bearN, bearLvl]

[cbN, cbL, csN, csL] = request.security(syminfo.tickerid, "1", f_cisd(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
newCisdBull = not na(cbN) and not na(cbN[1]) and cbN > cbN[1]
newCisdBear = not na(csN) and not na(csN[1]) and csN > csN[1]

// رسم خط تحوّل السيطرة (MSS أبيض / CISD بنفسجي) + ملصق — دالة عامة
f_drawShift(float lvl, bool isMSS) =>
    col  = isMSS ? colMSS : colCISD
    txt  = isMSS ? "MSS" : "CISD"
    tcol = isMSS ? color.black : color.white
    ln = line.new(bar_index, lvl, bar_index + 10, lvl, xloc = xloc.bar_index, color = col, style = line.style_solid, width = 2)
    lb = label.new(bar_index, lvl, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(col, 25), textcolor = tcol, size = size.small)
    [ln, lb]

// ════════════════════════════════════════════════════════════════════════════
//  آلة الحالة — تحديد المناطق فقط (بلا توصية) / ZONE-MAPPING STATE MACHINE
//    0 خامل | 1 بعد Sweep (بانتظار تحوّل السيطرة) | 2 بانتظار FVG لرسم المنطقة
// ════════════════════════════════════════════════════════════════════════════
var int   st       = 0
var bool  sBull    = false      // اتجاه الإعداد: سحب قاع → صاعد ، سحب قمة → هابط
var float sLevel   = na         // المستوى المسحوب
var float sWick    = na         // طرف فتيل الـ Sweep
var int   sBar     = na
var int   cnt      = 0          // عداد انتظار تحوّل السيطرة
var bool  smtOn    = false      // نتيجة SMT المخزّنة (وسم فقط)
var bool  mssDone  = false      // في وضع "الاثنان": هل تأكد MSS؟
var int   shiftBar = na
var float fvgTop   = na
var float fvgBot   = na
var float fvgMid   = na
var int   fvgBar   = na
var int   zonesDay = 0          // عدد مناطق FVG المرسومة اليوم

// كائنات الرسم للإعداد الحالي / current-setup drawing objects
var label sweepLbl = na
var label smtTri   = na
var line  mssLine  = na
var label mssLbl   = na
var line  cisdLine = na
var label cisdLbl  = na
var box   fvgBox   = na
var line  fvgMidLn = na          // خط منتصف الفجوة (Consequent Encroachment)
var label fvgLbl   = na          // ملصق حدود المنطقة بالنقاط الدقيقة

// أعلام التنبيهات (تُصفّر كل شمعة) / alert flags (reset each bar)
bool aSweep = false
bool aMSS   = false
bool aCISD  = false
bool aFVG   = false

// ════════════════════════════════════════════════════════════════════════════
//  المنطق الرئيسي — فقط على الشمعة المُغلقة / MAIN LOGIC (confirmed bars only)
// ════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    bool cancel = false   // طلب إلغاء الإعداد (يحذف كل عناصره)

    // -- تصفير عدّاد المناطق يومياً --
    if newDay
        zonesDay := 0

    // -- بناء مستويات السيولة عند نهاية كل جلسة --
    if not inAsia and inAsia[1] and useAsia
        f_addLevel(asiaH,  true,  "Asia-H")
        f_addLevel(asiaL,  false, "Asia-L")
    if not inLondon and inLondon[1] and useLondon
        f_addLevel(londonH, true,  "London-H")
        f_addLevel(londonL, false, "London-L")
    if newDay and usePrevDay and not na(pdh) and not na(pdl)
        f_addLevel(pdh, true,  "PrevDay-H")
        f_addLevel(pdl, false, "PrevDay-L")

    // -- مدّ الخطوط وكشف الاختراق (إغلاق خارج المستوى ينهي الخط) --
    if array.size(liqLevels) > 0
        for i = array.size(liqLevels) - 1 to 0
            Liq lv = array.get(liqLevels, i)
            if not lv.broken
                broke = lv.isHigh ? close > lv.price : close < lv.price
                if broke
                    lv.broken := true
                    line.set_x2(lv.ln, bar_index)
                else
                    line.set_x2(lv.ln, bar_index + 1)

    // -- خارج نافذة نيويورك: ألغِ أي إعداد نشط ولا ترسم إشارات --
    if not inNY and st != 0
        cancel := true

    // ═══════════════════════════════════════════════════════════════════════
    //  آلة الحالة — نُقدّم الإعداد النشط أولاً (الحالات 1..4)، ثم مسح السحب لاحقاً
    //  ملاحظة: رسم الـ Sweep و SMT صار مستقلاً (أسفل) ليظهر لكل مستوى ويبقى دائماً
    // ═══════════════════════════════════════════════════════════════════════
    if inNY
        // ───────────────────────────────────────────────────────────────────
        // الحالة 1: بعد Sweep — انتظر تحوّل السيطرة خلال العداد
        // ───────────────────────────────────────────────────────────────────
        if st == 1
            cnt := cnt - 1
            // إلغاء فوري: شمعتان متتاليتان أغلقتا خارج المستوى = اختراق حقيقي
            outNow  = sBull ? close    < sLevel : close    > sLevel
            outPrev = sBull ? close[1] < sLevel : close[1] > sLevel
            if outNow and outPrev
                cancel := true
            else
                mssHit   = sBull ? (not na(lastPH) and close > lastPH) : (not na(lastPL) and close < lastPL)
                cisdHit  = sBull ? newCisdBull : newCisdBear
                mssLvlV  = sBull ? lastPH : lastPL
                cisdLvlV = sBull ? cbL    : csL
                bool shifted = false

                if isMSSonly and mssHit
                    line.delete(mssLine)
                    label.delete(mssLbl)
                    [ln, lb] = f_drawShift(mssLvlV, true)
                    mssLine := ln
                    mssLbl  := lb
                    aMSS := true
                    shifted := true
                else if isCISDonly and cisdHit
                    line.delete(cisdLine)
                    label.delete(cisdLbl)
                    [ln, lb] = f_drawShift(cisdLvlV, false)
                    cisdLine := ln
                    cisdLbl  := lb
                    aCISD := true
                    shifted := true
                else if isBoth
                    // MSS أولاً (بنية)، ثم CISD للتوقيت (شمعة)
                    if mssHit and not mssDone
                        line.delete(mssLine)
                        label.delete(mssLbl)
                        [ln, lb] = f_drawShift(mssLvlV, true)
                        mssLine := ln
                        mssLbl  := lb
                        mssDone := true
                        aMSS := true
                    if mssDone and cisdHit
                        line.delete(cisdLine)
                        label.delete(cisdLbl)
                        [ln2, lb2] = f_drawShift(cisdLvlV, false)
                        cisdLine := ln2
                        cisdLbl  := lb2
                        aCISD := true
                        shifted := true

                if shifted
                    shiftBar := bar_index
                    st := 2
                else if cnt <= 0
                    cancel := true       // انتهى العداد بلا تحوّل سيطرة

        // ───────────────────────────────────────────────────────────────────
        // الحالة 2: حدّد منطقة FVG وارسمها بدقة داخل حركة تحوّل السيطرة (10 شموع)
        //   لا توصية ولا دخول/ستوب/هدف — فقط رسم المنطقة بحدودها الفعلية بدقة.
        // ───────────────────────────────────────────────────────────────────
        else if st == 2
            bullFVG   = sBull and high[2] < low[0]
            bearFVG   = (not sBull) and low[2] > high[0]
            fTop      = sBull ? low[0]  : low[2]
            fBot      = sBull ? high[2] : high[0]
            sizeTicks = (fTop - fBot) / tick
            if (bullFVG or bearFVG) and sizeTicks >= minTicks
                // منطقة FVG بحدودها الدقيقة — تبدأ من الشمعة الوسطى وتمتد للأمام
                fvgTop := fTop
                fvgBot := fBot
                fvgMid := (fTop + fBot) / 2
                fvgBar := bar_index
                fvgBox := box.new(bar_index - 1, fvgTop, bar_index + 20, fvgBot, xloc = xloc.bar_index, border_color = color.new(#2196F3, 40), bgcolor = colFVG)
                // خط منتصف الفجوة (50% / Consequent Encroachment) — مرجع دقيق
                fvgMidLn := line.new(bar_index - 1, fvgMid, bar_index + 20, fvgMid, xloc = xloc.bar_index, color = color.new(#2196F3, 20), style = line.style_dotted, width = 1)
                // ملصق يعرض حدود المنطقة بالنقاط الدقيقة (بالملّي)
                zTxt = "FVG  " + str.tostring(fvgTop, format.mintick) + " ⟷ " + str.tostring(fvgBot, format.mintick) + (smtOn ? "  •SMT" : "")
                fvgLbl := label.new(bar_index + 20, fvgMid, zTxt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(#2196F3, 20), textcolor = color.white, size = size.tiny)
                aFVG := true
                zonesDay := zonesDay + 1
                // فصل كائنات هذا الإعداد لتبقى ظاهرة والإعداد التالي يبدأ نظيفاً
                sweepLbl := na
                smtTri   := na
                mssLine  := na
                mssLbl   := na
                cisdLine := na
                cisdLbl  := na
                fvgBox   := na
                fvgMidLn := na
                fvgLbl   := na
                st := 0                   // اكتملت المنطقة → عُد لمسح المنطقة التالية
            else if not na(shiftBar) and bar_index - shiftBar > 10
                cancel := true           // لا FVG خلال 10 شموع → إلغاء الإعداد

    // ═══════════════════════════════════════════════════════════════════════
    //  مسح السحب — يُرسم لكل مستوى ويبقى دائماً (مستقل عن آلة الحالة)
    //  كل Sweep + مثلث SMT يظهران للمراجعة ولا يُحذفان تلقائياً.
    //  أول Sweep أثناء الخمول يُتبنّى كإعداد لتتبّع تحوّل السيطرة ثم رسم منطقة FVG.
    // ═══════════════════════════════════════════════════════════════════════
    if inNY and array.size(liqLevels) > 0
        for i = 0 to array.size(liqLevels) - 1
            Liq lv = array.get(liqLevels, i)
            if not lv.broken and not lv.swept
                sweptHigh =      lv.isHigh and high > lv.price and close < lv.price
                sweptLow  = not lv.isHigh and low  < lv.price and close > lv.price
                if sweptHigh or sweptLow
                    lv.swept := true
                    dirBull  = sweptLow             // سحب قاع → صاعد
                    yTip     = dirBull ? low : high
                    stl      = dirBull ? label.style_label_up : label.style_label_down
                    // علامة Sweep برتقالية دائمة عند طرف الفتيل
                    swLbl = label.new(bar_index, yTip, "✕ SWEEP", xloc = xloc.bar_index, style = stl, color = color.new(colSweep, 15), textcolor = color.white, size = size.small)
                    // مثلث SMT أصفر دائم إن وُجد التباين (يحدد الحجم فقط)
                    smtHere = dirBull ? smtBullEval : smtBearEval
                    label smtObj = na
                    if smtHere
                        tstl = dirBull ? label.style_triangleup : label.style_triangledown
                        ytr  = dirBull ? low - 3 * tick : high + 3 * tick
                        smtObj := label.new(bar_index, ytr, "", xloc = xloc.bar_index, style = tstl, color = colSMT, size = size.tiny)
                    aSweep := true
                    // تبنّي أول Sweep كإعداد نشط عند الخمول (بلا حد — كل المناطق تُرسم)
                    if st == 0
                        sBull   := dirBull
                        sLevel  := lv.price
                        sWick   := yTip
                        sBar    := bar_index
                        cnt     := maxWait
                        smtOn   := smtHere
                        mssDone := false
                        st      := 1
                        sweepLbl := swLbl           // مرجع للحذف الاختياري فقط
                        smtTri   := smtObj

    // ───────────────────────────────────────────────────────────────────────
    // إلغاء الإعداد: يُعاد ضبط الحالة دائماً. الحذف الفعلي فقط عند تفعيل autoClean
    // (افتراضياً معطّل → تبقى كل الإشارات ظاهرة على الشارت للمراجعة).
    // ───────────────────────────────────────────────────────────────────────
    if cancel
        if autoClean
            label.delete(sweepLbl)
            label.delete(smtTri)
            line.delete(mssLine)
            label.delete(mssLbl)
            line.delete(cisdLine)
            label.delete(cisdLbl)
            box.delete(fvgBox)
            line.delete(fvgMidLn)
            label.delete(fvgLbl)
        sweepLbl := na
        smtTri   := na
        mssLine  := na
        mssLbl   := na
        cisdLine := na
        cisdLbl  := na
        fvgBox   := na
        fvgMidLn := na
        fvgLbl   := na
        sBull    := false
        sLevel   := na
        sWick    := na
        sBar     := na
        cnt      := 0
        smtOn    := false
        mssDone  := false
        shiftBar := na
        fvgTop   := na
        fvgBot   := na
        fvgMid   := na
        fvgBar   := na
        st       := 0

// ════════════════════════════════════════════════════════════════════════════
//  ⑤ لوحة المعلومات / DASHBOARD (top-right)
// ════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 5, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
if barstate.islast
    stateTxt = st == 0 ? "خامل / Idle" : st == 1 ? "بانتظار تحوّل / Wait Shift" : "بانتظار FVG / Wait FVG"
    smtTxt   = not smtEnabled ? "—" : (smtOn ? "✓" : "✗")
    cntTxt   = st == 1 ? str.tostring(math.max(cnt, 0)) : "—"
    bg = color.new(color.black, 15)
    table.cell(dash, 0, 0, "NY LIQUIDITY", text_color = color.white, bgcolor = color.new(#FF8C00, 10), text_size = size.small)
    table.cell(dash, 1, 0, "MODEL",        text_color = color.white, bgcolor = color.new(#FF8C00, 10), text_size = size.small)
    table.cell(dash, 0, 1, "الحالة",        text_color = color.silver, bgcolor = bg, text_size = size.small)
    table.cell(dash, 1, 1, stateTxt,        text_color = color.white,  bgcolor = bg, text_size = size.small)
    table.cell(dash, 0, 2, "SMT",           text_color = color.silver, bgcolor = bg, text_size = size.small)
    table.cell(dash, 1, 2, smtTxt,          text_color = smtOn ? colSMT : color.silver, bgcolor = bg, text_size = size.small)
    table.cell(dash, 0, 3, "العداد",         text_color = color.silver, bgcolor = bg, text_size = size.small)
    table.cell(dash, 1, 3, cntTxt,          text_color = color.white,  bgcolor = bg, text_size = size.small)
    table.cell(dash, 0, 4, "مناطق اليوم",    text_color = color.silver, bgcolor = bg, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(zonesDay), text_color = color.white, bgcolor = bg, text_size = size.small)

// ════════════════════════════════════════════════════════════════════════════
//  التنبيهات / ALERTS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(aSweep, "Sweep", "NY Liquidity Model: Sweep — تم سحب السيولة")
alertcondition(aMSS,   "MSS",   "NY Liquidity Model: MSS — تحوّل السيطرة البنيوي")
alertcondition(aCISD,  "CISD",  "NY Liquidity Model: CISD — تحوّل السيطرة الشمعي")
alertcondition(aFVG,   "FVG",   "NY Liquidity Model: FVG — تحدّدت منطقة الفجوة")
